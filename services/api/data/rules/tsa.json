    "severity": "restricted",
    "carryOn": "ok",
    "checked": "restricted",
    "text": "Disposable and Zippo lighters are allowed in carry-on. In checked bags they must be empty of fuel, unless packed in a DOT-approved case (up to two).",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/lighters-disposable-and-zippo",
