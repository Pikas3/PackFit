[
  {
    "ruleId": "tsa:liquids-100ml",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["shampoo", "liquid", "lotion", "gel", "cream", "toiletry", "perfume", "aerosol"],
    "categories": ["liquids", "toiletries"],
    "severity": "restricted",
    "carryOn": "restricted",
    "checked": "ok",
    "text": "Liquids, aerosols, and gels in carry-on must be in containers of 3.4 oz (100 ml) or less and fit in one quart-sized bag.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/liquids-aerosols-and-gels",
    "lastVerified": "2026-10-01",
    "limits": { "maxMl": 100 }
  },
  {
    "ruleId": "tsa:pocket-knife",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["knife", "pocket knife", "blade", "swiss army"],
    "categories": ["sharp"],
    "severity": "banned",
    "carryOn": "banned",
    "checked": "ok",
    "text": "Pocket knives and blades longer than a butter knife are not allowed in carry-on bags. Pack them in checked baggage.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/pocket-knife",
    "lastVerified": "2026-09-15"
  },
  {
    "ruleId": "tsa:lithium-battery-spare",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["power bank", "battery", "lithium", "portable charger", "anker"],
    "categories": ["electronics"],
    "severity": "restricted",
    "carryOn": "ok",
    "checked": "banned",
    "text": "Spare (uninstalled) lithium batteries and power banks must go in carry-on, not checked baggage. Capacity limits apply (generally under 100 Wh without airline approval).",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/power-banks",
    "lastVerified": "2026-10-01",
    "limits": { "maxWh": 100 }
  },
  {
    "ruleId": "tsa:lighter",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["lighter", "matches", "bic"],
    "categories": ["other"],
    "severity": "restricted",
    "carryOn": "restricted",
    "checked": "banned",
    "text": "One disposable lighter is usually allowed in carry-on; torch lighters are banned. Lighters are generally not allowed in checked bags.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/lighter",
    "lastVerified": "2026-09-20"
  },
  {
    "ruleId": "tsa:aerosols",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["aerosol", "spray", "deodorant spray", "hairspray"],
    "categories": ["liquids", "toiletries"],
    "severity": "restricted",
    "carryOn": "restricted",
    "checked": "restricted",
    "text": "Aerosol toiletries follow the 3-1-1 liquids rule in carry-on. Larger aerosols may go in checked bags if not labeled as hazardous.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/aerosol",
    "lastVerified": "2026-10-01",
    "limits": { "maxMl": 100 }
  },
  {
    "ruleId": "tsa:peanut-butter",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["peanut butter", "nut butter", "jam", "spread"],
    "categories": ["food"],
    "severity": "restricted",
    "carryOn": "restricted",
    "checked": "ok",
    "text": "Peanut butter and similar spreads over 3.4 oz (100 ml) are not allowed in carry-on and should go in checked baggage.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/peanut-butter",
    "lastVerified": "2026-09-28",
    "limits": { "maxMl": 100 }
  },
  {
    "ruleId": "tsa:laptop",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["laptop", "notebook computer", "macbook"],
    "categories": ["electronics"],
    "severity": "check",
    "carryOn": "ok",
    "checked": "ok",
    "text": "Laptops are allowed in carry-on and checked bags. At security you may need to remove the laptop from its case for screening.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/laptop",
    "lastVerified": "2026-10-05"
  },
  {
    "ruleId": "tsa:medication-liquids",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["medicine", "medication", "prescription", "insulin"],
    "categories": ["medical", "liquids"],
    "severity": "check",
    "carryOn": "ok",
    "checked": "ok",
    "text": "Medications in liquid form larger than 3.4 oz are allowed in carry-on when declared for inspection. Keep them accessible.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/medications",
    "lastVerified": "2026-09-30"
  }
]
