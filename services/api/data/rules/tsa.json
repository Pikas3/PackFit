    "severity": "banned",
    "carryOn": "banned",
    "checked": "banned",
    "text": "Torch (jet-flame) lighters are not allowed in carry-on or checked bags.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/lighters-torch",
    "lastVerified": "2026-10-24"
