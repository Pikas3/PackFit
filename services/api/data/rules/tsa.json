[
  {
    "ruleId": "tsa:liquids-100ml",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["shampoo", "liquid", "lotion", "gel", "cream", "toiletry", "perfume", "aerosol"],
    "categories": ["liquids", "toiletries"],
    "severity": "restricted",
    "carryOn": "restricted",
    "checked": "ok",
    "text": "Liquids, gels, aerosols, creams and pastes in carry-on must be 3.4 oz (100 ml) or less per container and fit in one quart-sized bag. Larger containers go in checked baggage.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/liquids-aerosols-gels-rule",
    "lastVerified": "2026-10-24",
    "limits": { "maxMl": 100 }
  },
  {
    "ruleId": "tsa:pocket-knife",
    "scope": "tsa",
    "subject": "all",
    "keywords": ["knife", "pocket knife", "blade", "swiss army"],
    "categories": ["sharp"],
    "severity": "banned",
    "carryOn": "banned",
    "checked": "ok",
    "text": "Knives are not allowed in carry-on bags, except round-bladed butter knives and plastic cutlery. Pack them in checked baggage.",
    "sourceUrl": "https://www.tsa.gov/travel/security-screening/whatcanibring/items/knives",
    "lastVerified": "2026-10-24"
  },
  {
