ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
APIFY_TOKEN=
# Live flight lookup uses APIFY_TOKEN with this actor (about $0.003 per lookup, cached per
# flight number). Leave empty for the default, apt_marble~flight-status-tracker.
APIFY_FLIGHT_ACTOR=
# Optional second live source (https://aviationstack.com), tried when Apify finds nothing.
AVIATIONSTACK_API_KEY=
# The free plan refuses https; set http://api.aviationstack.com/v1 to use it (the key then
# travels unencrypted, so use a free key you do not mind losing). Paid plans keep the default.
AVIATIONSTACK_BASE_URL=
APP_TOKEN=local-dev-token
PORT=8787
# When 1 (or ANTHROPIC_API_KEY empty), Claude calls use deterministic local stubs for tests/demo.
MOCK_CLAUDE=1
