{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packfit.local/schemas/trip.schema.json",
  "title": "Trip",
  "type": "object",
  "additionalProperties": false,
  "required": ["from", "to", "airline", "nights", "activities", "carryOn", "checked"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "from": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "to": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "airline": { "type": "string", "pattern": "^[A-Z0-9]{2}$" },
    "nights": { "type": "integer", "minimum": 0 },
    "activities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "carryOn": { "$ref": "container.schema.json" },
    "checked": { "$ref": "container.schema.json" },
    "departDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
