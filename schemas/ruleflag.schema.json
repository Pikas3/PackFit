{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snugly.local/schemas/ruleflag.schema.json",
  "title": "RuleFlag",
  "description": "Travel-rule guidance for one item. Guidance, never authority: always carries a source and a verification date.",
  "type": "object",
  "additionalProperties": false,
  "required": ["itemId", "scope", "severity", "text", "sourceUrl", "lastVerified"],
  "properties": {
    "itemId": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["tsa", "airline", "country"] },
    "severity": { "enum": ["banned", "restricted", "check"] },
    "text": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "pattern": "^https?://" },
    "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "ruleId": { "type": "string", "minLength": 1 }
  }
}
